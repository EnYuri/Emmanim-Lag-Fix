<Project>
  <PropertyGroup>
    <CosmoteerBin Condition="'$(CosmoteerBin)' == ''">$(COSMOTEER_BIN)</CosmoteerBin>
    <CosmoteerBin Condition="'$(CosmoteerBin)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cosmoteer\Bin</CosmoteerBin>
  </PropertyGroup>

  <Target Name="ValidateCosmoteerBin" BeforeTargets="ResolveReferences"
          Condition="!Exists('$(CosmoteerBin)\Cosmoteer.dll')">
    <Error Text="Set COSMOTEER_BIN or pass -p:CosmoteerBin=... pointing to Cosmoteer's Bin directory." />
  </Target>
</Project>
